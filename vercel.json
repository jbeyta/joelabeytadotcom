{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/apps", "destination": "/apps.html" }
  ],
  "redirects": [
    { "source": "/goals", "destination": "/apps#goals", "permanent": false },
    { "source": "/list", "destination": "/apps#list", "permanent": false }
  ]
}
